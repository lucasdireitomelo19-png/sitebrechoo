# Postgres. Em desenvolvimento local, aponte para um Postgres local
# (ex: postgresql://postgres:postgres@localhost:5432/sitebrechoo).
# Em produção na Vercel, use a URL do Vercel Postgres/Neon (definida
# automaticamente ao conectar o banco ao projeto).
DATABASE_URL=""

# NextAuth (Auth.js v5)
AUTH_SECRET="gere-um-valor-aleatorio-com-openssl-rand-base64-32"
NEXTAUTH_SECRET="gere-um-valor-aleatorio-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Admin seed credentials (usadas por prisma/seed.ts)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@brecho.com"
ADMIN_PASSWORD="troque-esta-senha"

# Upload de imagens dos produtos.
# Deixe em branco em dev local (salva em public/uploads).
# Na Vercel, conecte um Blob Store ao projeto — a variável é injetada
# automaticamente com o nome abaixo.
BLOB_READ_WRITE_TOKEN=""

# PagBank / PagSeguro (opcional por enquanto — sem token, o checkout cria o
# pedido mas mostra uma mensagem de "pagamento indisponível" ao cliente)
# Sandbox: https://sandbox.api.pagseguro.com | Producao: https://api.pagseguro.com
PAGBANK_API_URL="https://sandbox.api.pagseguro.com"
PAGBANK_TOKEN=""
PAGBANK_NOTIFICATION_URL="http://localhost:3000/api/webhooks/pagbank"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contato exibido no rodapé (opcional — cada um só aparece se preenchido)
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_WHATSAPP_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
